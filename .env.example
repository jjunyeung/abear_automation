# Windly ATC Framework — 환경변수 템플릿
# 사용법: cp .env.example .env && vi .env
#
# 이 파일은 커밋되며, 실제 시크릿이 들어 있는 .env 는 .gitignore 로 제외된다.
# Claude 는 .env 를 직접 편집할 수 없도록 hook (.claude/hooks/block-env.sh) 으로 차단되어 있다.
# 변수 추가/제거 시:
#   1) lib/config.ts 의 envSchema (zod) 에 키를 동기화
#   2) 본 .env.example 에 동일 키 + 주석을 추가

# ─── 윈들리 API ─────────────────────────────────────────────
# 윈들리 본체 API 베이스 URL.
# 기본값: https://app-api.windly.cc
WINDLY_BASE_URL=https://app-api.windly.cc

# ─── 윈들리 Chrome 확장 (D7, UI ATC에 한해 필수) ────────────
# 윈들리 Chrome 확장의 절대 경로 (확장 디렉토리, manifest.json 이 들어있는 폴더).
#
# 확인 방법:
#   1. chrome://extensions 진입
#   2. 우상단 "개발자 모드" ON
#   3. 윈들리 확장 카드의 "ID" 복사
#   4. 경로 조립:
#      ~/Library/Application Support/Google/Chrome/Default/Extensions/<ID>/<version>
#
# 미설정 시: playwright.config.ts 가 일반 Chromium 으로 fallback (UI ATC 는 실패할 수 있음).
WINDLY_EXTENSION_PATH=

# ─── 윈들리 로그인 (선택) ──────────────────────────────────
# UI ATC 가 자동 로그인 step 을 수행할 때 사용.
# 미설정 시: 사용자가 직접 로그인하거나, 로그인을 요구하는 ATC 는 실패.
WINDLY_LOGIN_EMAIL=
WINDLY_LOGIN_PASSWORD=

# ─── OAuth 실 로그인 검증 (선택, R9+) ──────────────────────
# atcs/windly-shell/oauth-login-{naver,google}.atc.yml 에서 사용.
# 결정 10 — "로그인만 되는지 확인" 수준. 자동화로 자격증명 입력 → 콜백 검증.
#
# 주의:
#   - 네이버는 봇 검사 강함 → headless 자동화가 차단될 수 있음.
#   - 2FA 가 켜져 있으면 자동화 불가.
#   - 미설정 시 해당 spec 은 skip + 명확한 에러 메시지.
NAVER_TEST_EMAIL=
NAVER_TEST_PASSWORD=
GOOGLE_TEST_EMAIL=
GOOGLE_TEST_PASSWORD=
KAKAO_TEST_EMAIL=

# ─── 직원 계정 (선택, e2e K2) ─────────────────────────────
# atcs/e2e/staff-account-permission.atc.yml 에서 사용.
# 권한 분기 검증을 위해 일반 직원 권한 계정 필요.
WINDLY_STAFF_EMAIL=
WINDLY_STAFF_PASSWORD=

# ─── URL 풀 (선택, 자동 회귀) ────────────────────────────
# 매 실행 새 URL 이 필요한 e2e (A 그룹) 가 head 1개씩 자동 consume.
# 형식: data/url-pool/{taobao,tmall,rakuten}.txt — 한 줄 한 URL.
# 사용된 URL 은 history (.url-collect-history.log) 로 중복 차단됨.
# 미설정 시 ATC_INPUT_PRODUCT_URL 단일 변수 사용 (수동 실행).
ATC_URL_POOL_DIR=data/url-pool

# ─── Slack 알림 (선택, 스케줄 전용) ────────────────────────
# launchd 스케줄이 발화한 ATC 가 끝나면 결과 요약을 이 incoming webhook 으로 POST.
# GUI 에서 직접 실행한 건은 알림 안 보냄 — 스케줄 발화만 통과하는 atc-multi.mjs 에서만 호출.
# 비워두면 silent skip (Slack 안 씀).
#
# 발급 방법:
#   1. https://api.slack.com/messaging/webhooks → "Create your Slack app"
#   2. Incoming Webhooks 토글 ON → "Add New Webhook to Workspace"
#   3. 알림 받을 채널 선택 → 발급된 URL 복사
#   4. `https://hooks.slack.com/services/T.../B.../...` 을 아래에 붙여넣기
#
# 보안 주의: 이 URL 은 그 채널 글쓰기 권한과 동일. 커밋/공유 금지.
SLACK_WEBHOOK_URL=

# ─── Slack Bot (선택, DM 또는 임의 채널) ──────────────────
# Webhook 은 발급 시 채널 1개 고정이라 DM/타 채널 송신 불가.
# Bot Token 방식이면 SLACK_TARGET_CHANNEL 에 임의 채널 ID (또는 DM channel ID) 사용 가능.
#
# 발급 방법:
#   1. https://api.slack.com/apps → Create New App ("Windly Regression Bot")
#   2. OAuth & Permissions → Bot Token Scopes 에 `chat:write` 추가
#   3. Install to Workspace → "Bot User OAuth Token" (xoxb-...) 복사
#   4. private 채널이면 그 채널에 봇 invite: 채널에서 `/invite @봇이름`
#
# 우선순위: Bot Token + Target Channel 이 둘 다 있으면 chat.postMessage 사용,
# 실패 또는 미설정이면 SLACK_WEBHOOK_URL 로 fallback.
SLACK_BOT_TOKEN=
SLACK_TARGET_CHANNEL=

# ─── ATC 입력 오버라이드 (선택, 디버그용) ───────────────────
# spec 안에서 process.env.ATC_INPUT_URL 을 우선 참조하는 vertical slice 패턴 지원용.
# 평소에는 비워두고 CLI 인자(--url=...) 또는 fixture 로 주입 권장 (D8).
ATC_INPUT_URL=
