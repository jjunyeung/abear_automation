# Windly ATC Framework — 환경변수 템플릿
# 사용법: cp .env.example .env && vi .env
#
# 이 파일은 커밋되며, 실제 시크릿이 들어 있는 .env 는 .gitignore 로 제외된다.
# Claude 는 .env 를 직접 편집할 수 없도록 hook (.claude/hooks/block-env.sh) 으로 차단되어 있다.
# 변수 추가/제거 시:
#   1) lib/config.ts 의 envSchema (zod) 에 키를 동기화
#   2) 본 .env.example 에 동일 키 + 주석을 추가

# ─── 윈들리 API ─────────────────────────────────────────────
# 윈들리 본체 API 베이스 URL.
# 기본값: https://app-api.windly.cc
WINDLY_BASE_URL=https://app-api.windly.cc

# ─── 윈들리 Chrome 확장 (D7, UI ATC에 한해 필수) ────────────
# 윈들리 Chrome 확장의 절대 경로 (확장 디렉토리, manifest.json 이 들어있는 폴더).
#
# 확인 방법:
#   1. chrome://extensions 진입
#   2. 우상단 "개발자 모드" ON
#   3. 윈들리 확장 카드의 "ID" 복사
#   4. 경로 조립:
#      ~/Library/Application Support/Google/Chrome/Default/Extensions/<ID>/<version>
#
# 미설정 시: playwright.config.ts 가 일반 Chromium 으로 fallback (UI ATC 는 실패할 수 있음).
WINDLY_EXTENSION_PATH=

# ─── 윈들리 로그인 (선택) ──────────────────────────────────
# UI ATC 가 자동 로그인 step 을 수행할 때 사용.
# 미설정 시: 사용자가 직접 로그인하거나, 로그인을 요구하는 ATC 는 실패.
WINDLY_LOGIN_EMAIL=
WINDLY_LOGIN_PASSWORD=

# ─── Slack 알림 (선택, 스케줄 전용) ────────────────────────
# launchd 스케줄이 발화한 ATC 가 끝나면 결과 요약을 이 incoming webhook 으로 POST.
# GUI 에서 직접 실행한 건은 알림 안 보냄 — 스케줄 발화만 통과하는 atc-multi.mjs 에서만 호출.
# 비워두면 silent skip (Slack 안 씀).
#
# 발급 방법:
#   1. https://api.slack.com/messaging/webhooks → "Create your Slack app"
#   2. Incoming Webhooks 토글 ON → "Add New Webhook to Workspace"
#   3. 알림 받을 채널 선택 → 발급된 URL 복사
#   4. `https://hooks.slack.com/services/T.../B.../...` 을 아래에 붙여넣기
#
# 보안 주의: 이 URL 은 그 채널 글쓰기 권한과 동일. 커밋/공유 금지.
SLACK_WEBHOOK_URL=

# ─── ATC 입력 오버라이드 (선택, 디버그용) ───────────────────
# spec 안에서 process.env.ATC_INPUT_URL 을 우선 참조하는 vertical slice 패턴 지원용.
# 평소에는 비워두고 CLI 인자(--url=...) 또는 fixture 로 주입 권장 (D8).
ATC_INPUT_URL=
