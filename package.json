{
  "name": "windly-atc-framework",
  "version": "0.1.0",
  "description": "Playwright 기반 ATC 실행 프레임워크",
  "private": true,
  "scripts": {
    "atc": "node scripts/atc.mjs",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:deps": "node scripts/check-deps.mjs",
    "gui": "npm run gui:build:main && concurrently -k -n vite,electron -c blue,green \"vite --config gui/vite.config.mts\" \"wait-on tcp:5273 && electron gui/dist/gui/main/index.js\"",
    "gui:dev": "npm run gui",
    "gui:build:main": "tsc -p gui/main/tsconfig.json",
    "gui:build": "npm run gui:build:main && vite build --config gui/vite.config.mts && electron-builder --config gui/electron-builder.yml",
    "build:gui:main": "tsc -p gui/main/tsconfig.json",
    "build:gui:renderer": "vite build --config gui/vite.config.mts",
    "build:gui": "npm run build:gui:main && npm run build:gui:renderer",
    "package:gui": "npm run build:gui && electron-builder --config gui/electron-builder.yml",
    "coverage": "node scripts/coverage-report.mjs",
    "executability": "node scripts/executability-report.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yaml": "^1.9.6",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.13.0",
    "@blueprintjs/icons": "^6.10.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.0.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  }
}
