{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "moduleResolution": "node",
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["gui/renderer/src/*"]
    }
  },
  "include": ["lib/**/*", "tests/**/*", "recoveries/**/*", "reporters/**/*", "playwright.config.ts", "gui/**/*"],
  "exclude": ["node_modules", "dist", "reports", "gui/vite.config.mts", "gui/dist"]
}
